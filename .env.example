# Copy to .env (gitignored) and fill in. Only OPENAI_API_KEY is required.
OPENAI_API_KEY=

# Gated Hugging Face models (Llama Prompt Guard 2, Llama Guard 4, Sentinel v2): accept each licence first.
HF_TOKEN=

# Optional: path to the ai-security-evals checkout, if it is not next to this repo.
# EVALS_REPO=../ai-security-evals

# Optional: s1guard / decision-model backend: laya (local, default) | jev | http (any /v1/systemone server).
# S1GUARD_BACKEND=laya
# TYPESAFE_API_KEY=
# S1GUARD_URL=http://localhost:8000

# Optional: LiteLLM spend DB for chargeback (docs/chargeback.md).
# DATABASE_URL=postgresql://litellm:litellm-local@127.0.0.1:5433/litellm
